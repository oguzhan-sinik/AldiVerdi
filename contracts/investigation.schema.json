{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefront3d.local/contracts/investigation.schema.json",
  "title": "FireFront Investigation Contract v1",
  "description": "Bounded investigation trace and claims. Mock/fixture runs must set execution_mode accordingly and only cite evidence_ids that exist in the incident manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "investigation_id",
    "incident_id",
    "execution_mode",
    "status",
    "question",
    "actions",
    "claims"
  ],
  "properties": {
    "investigation_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "mock",
        "cached_replay",
        "live"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "complete",
        "failed",
        "fixture_only"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "budget_remaining": {
      "type": "integer",
      "minimum": 0
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "tool",
          "status"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "tool": {
            "type": "string",
            "enum": [
              "search_evidence",
              "inspect_clip",
              "get_camera",
              "select_next_evidence",
              "compare_observations",
              "localize_event",
              "get_temporal_changes",
              "summarize_findings",
              "finish_report"
            ]
          },
          "args": {
            "type": "object"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elapsed_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ok",
              "error",
              "skipped"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "measured",
              "inferred",
              "unresolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    }
  }
}
