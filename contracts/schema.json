{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefront.local/contracts/incident.schema.json",
  "title": "FireFront Incident Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "name",
    "data_mode",
    "cameras",
    "videos",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "synthetic_fixture",
        "source_backed",
        "live"
      ]
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "name",
        "lat",
        "lon",
        "alt_m",
        "heading_deg",
        "fov_deg",
        "geometry_status"
      ],
      "properties": {
        "camera_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "heading_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "fov_deg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "geometry_status": {
          "enum": [
            "unavailable",
            "partial",
            "verified"
          ]
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_id",
        "camera_id",
        "source_url",
        "playback_status",
        "duration_s",
        "recording_start_utc",
        "timestamp_basis",
        "rights_note"
      ],
      "properties": {
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "camera_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "playback_status": {
          "enum": [
            "unavailable",
            "available",
            "remote"
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "recording_start_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timestamp_basis": {
          "enum": [
            "unknown",
            "real_time",
            "time_lapse_relative"
          ]
        },
        "rights_note": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "video_id",
        "start_s",
        "end_s",
        "status",
        "description",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "observed",
            "measured",
            "hypothesized",
            "unresolved"
          ]
        },
        "description": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
