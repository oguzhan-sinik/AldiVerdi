{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefront3d.local/contracts/incident.schema.json",
  "title": "FireFront Incident Contract v1",
  "description": "Shared incident / camera / video / evidence contract. Nullable coordinates and headings are intentional: unknown metadata must remain null, never fabricated. data_mode distinguishes synthetic fixtures from source-backed manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "title",
    "data_mode",
    "cameras",
    "videos",
    "evidence"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "synthetic_fixture",
        "source_backed"
      ],
      "description": "synthetic_fixture = UI/contract scaffolding only. source_backed = verified incident assets from Developer B."
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera_id",
          "lat",
          "lon",
          "orientation_verified"
        ],
        "properties": {
          "camera_id": {
            "type": "string",
            "minLength": 1
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "alt_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "heading_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 360,
            "description": "Geodetic degrees clockwise from true north. Null when unverified."
          },
          "hfov_deg": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 180
          },
          "orientation_verified": {
            "type": "boolean"
          },
          "geometry_status": {
            "type": "string",
            "enum": [
              "verified",
              "estimated",
              "unavailable"
            ],
            "default": "unavailable"
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "video_id",
          "camera_id",
          "source_url",
          "duration_s",
          "playback_status"
        ],
        "properties": {
          "video_id": {
            "type": "string",
            "minLength": 1
          },
          "camera_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "description": "Public source page, direct media URL, or fixture:// placeholder. Never invent a playable URL for unacquired media."
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "playback_status": {
            "type": "string",
            "enum": [
              "playable",
              "unavailable",
              "pending_acquisition"
            ]
          },
          "recording_start_utc": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-8601 UTC wall-clock start if known; null otherwise. Distinct from video-relative start_s/end_s."
          },
          "timestamp_basis": {
            "type": "string",
            "enum": [
              "recorded_utc",
              "source_local_time",
              "time_lapse_relative",
              "unknown",
              "synthetic_fixture"
            ]
          },
          "rights_note": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "video_id",
          "start_s",
          "end_s",
          "observation",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "video_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional segment grouping ID. Prefer video_id + start_s/end_s as the canonical seek target."
          },
          "start_s": {
            "type": "number",
            "minimum": 0,
            "description": "Video-relative seconds from the start of the referenced media asset."
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "measured",
              "inferred",
              "unresolved"
            ],
            "description": "observed=visible in footage; measured=tool/algorithm output; inferred=interpretation; unresolved=insufficient evidence."
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    }
  }
}
